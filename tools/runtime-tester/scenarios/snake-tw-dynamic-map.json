      "queries": [
        {
          "name": "viewport",
          "locator": { "css": ".game-viewport" },
          "fields": ["scroll_top", "client_height"]
        },
        {
          "name": "map",
          "locator": { "css": ".game-line" },
          "fields": ["count", "content_signature"]

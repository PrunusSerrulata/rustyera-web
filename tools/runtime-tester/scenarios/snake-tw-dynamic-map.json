{
  "schema_version": 1,
  "project": "../../../../games/eratw-sub-modding",
  "mode": "fixed",
  "compiled_cache": false,
  "summary_observations": true,
  "seed": 123456,
  "start": {
    "type": "new_game"
  },
  "actions": [

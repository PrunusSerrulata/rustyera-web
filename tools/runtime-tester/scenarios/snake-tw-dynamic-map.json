        "maximum_change_interval_ms": {
          "runtime.presentation_revision": 700,
          "map.content_signature": 700
        },
        "stable": ["viewport.scroll_top", "viewport.client_height"],
        "changes": [
          "runtime.presentation_revision",
          "runtime.history_revision",
          "map.content_signature"
        ]
      }
    },
    {
      "type": "hover",
      "locator": { "role": "button", "name": "[预览图切换(1)]", "exact": true }
    },
    { "type": "wait_timed_input_change" },
    { "type": "wait_timed_input_change" },
    {
      "type": "assert_state",
      "expect": { "canInteract": true, "fault": null }
    },
    {
      "type": "sample_queries",
      "count": 2,
      "interval_ms": 100,
      "queries": [
        {
          "name": "viewport",
          "locator": { "css": ".game-viewport" },
          "fields": ["scroll_top", "scroll_height", "client_height", "at_scroll_bottom"]
        },
        {
          "name": "map",
          "locator": { "css": ".game-line" },
          "fields": ["count", "content_signature"]
        },
        {
          "name": "control",
          "locator": { "role": "button", "name": "[预览图切换(1)]", "exact": true },
          "fields": ["count", "visible", "enabled", "box"]
        }
      ],
      "expect": {
        "maximum_sample_duration_ms": 1000,
        "stable": [
          "viewport.scroll_top",
          "viewport.client_height",
          "control.count",
          "control.visible",
          "control.box.top",
          "control.box.left",
          "control.box.width",
          "control.box.height"

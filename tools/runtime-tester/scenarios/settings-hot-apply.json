{
  "schema_version": 1,
  "project": "../../../../emuera.em/emuera-reference-cli/tests/fixture",
  "mode": "fixed",
  "seed": 123456,
  "actions": [
    { "type": "click", "locator": { "role": "button", "name": "文件", "exact": true } },
    { "type": "click", "locator": { "role": "button", "name": "设置…", "exact": true } },
    { "type": "click", "locator": { "css": "#setting-UseMenu" } },
    { "type": "click", "locator": { "role": "button", "name": "应用", "exact": true } },
    {
      "type": "assert_dom",
      "locator": { "css": "#setting-UseMenu" },
      "fields": ["count", "visible", "enabled", "attributes"],
      "expect": {
        "count": 1,
        "visible": true,
        "enabled": true,
        "attributes": { "type": "checkbox" }
      }
    },
    { "type": "click", "locator": { "role": "tab", "name": "显示", "exact": true } },
    { "type": "fill", "locator": { "css": "#setting-FontName" }, "value": "monospace" },
    { "type": "fill", "locator": { "css": "#setting-FontSize" }, "value": "19" },
    { "type": "click", "locator": { "role": "button", "name": "应用", "exact": true } },
    { "type": "click", "locator": { "role": "button", "name": "取消", "exact": true } },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-viewport" },
      "fields": ["count", "visible", "computed_style"],
      "expect": {
        "count": 1,
        "visible": true,
        "computed_style": { "font_family": "monospace", "font_size": "19px" }
      }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".prompt-bar input" },
      "fields": ["count", "value", "visible", "enabled"],
      "expect": { "count": 1, "value": "", "visible": true, "enabled": true }
    },
    {
      "type": "assert_state",
      "expect": { "projectOpen": true, "canInteract": true }
    }
  ],
  "limits": {
    "max_steps": 15,
    "timeout_seconds": 60
  }
}

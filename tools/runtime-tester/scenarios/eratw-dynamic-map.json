{
  "schema_version": 1,
  "project": "../../../../games/eraTW",
  "mode": "fixed",
  "compiled_cache": false,
  "start": {
    "type": "traditional_save",
    "path": "../../../../games/eraTW/sav/save17.sav"
  },
  "actions": [
    { "type": "input", "value": 120 },
    {
      "type": "assert_dom",
      "locator": { "text": "■博麗神社", "exact": true, "nth": -1 },
      "fields": ["count", "visible"],
      "expect": { "visible": true }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-line" },
      "fields": ["count", "square_grid"],
      "expect": {
        "square_grid": {
          "left": 0,
          "right": 608,
          "left_spread": 0,
          "right_spread": 0,
          "rows": 25,
          "edge_rows": 10,
          "aligned": true
        }
      }
    },
    {
      "type": "sample_queries",
      "count": 2,
      "interval_ms": 1100,
      "queries": [
        {
          "name": "lines",
          "locator": { "css": ".game-line" },
          "fields": ["content_signature", "square_grid"]
        }
      ],
      "expect": {
        "stable": ["lines.square_grid"],
        "changes": ["runtime.presentation_revision", "lines.content_signature"]
      }
    }
  ],
  "limits": {
    "max_steps": 30,
    "timeout_seconds": 900
  }
}

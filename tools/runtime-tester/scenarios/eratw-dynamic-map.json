{
  "schema_version": 1,
  "project": "../../../../games/eraTW",
  "mode": "fixed",
  "compiled_cache": false,
  "start": {
    "type": "traditional_save",
    "path": "../../../../games/eraTW/sav/save17.sav"
  },
  "actions": [
    { "type": "input", "value": 120 },
    {
      "type": "scroll_key",
      "locator": { "css": ".game-viewport" },
      "key": "PageUp"
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-button:has-text('[120] - 搬家')" },
      "fields": ["count", "enabled"],
      "expect": { "count": 1, "enabled": false }
    },
    {
      "type": "scroll_key",
      "locator": { "css": ".game-viewport" },
      "key": "End"
    },
    {
      "type": "assert_dom",
      "locator": { "text": "■博麗神社", "exact": true, "nth": -1 },
      "fields": ["count", "visible"],
      "expect": { "visible": true }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-line" },
      "fields": ["count", "square_grid"],
      "expect": {
        "square_grid": {
          "left": 0,
          "right": 608,
          "left_spread": 0,
          "right_spread": 0,
          "rows": 25,
          "edge_rows": 10,
          "interior_left": 128,
          "interior_spread": 0,
          "interior_rows": 5,
          "interior_counts": [1, 1, 1, 1, 1],
          "aligned": true
        }
      }
    },
    {
      "type": "sample_queries",
      "count": 2,
      "interval_ms": 1100,
      "queries": [
        {
          "name": "lines",
          "locator": { "css": ".game-line" },
          "fields": ["content_signature", "square_grid"]
        }
      ],
      "expect": {
        "stable": [
          "lines.square_grid.left",
          "lines.square_grid.right",
          "lines.square_grid.left_spread",
          "lines.square_grid.right_spread",
          "lines.square_grid.rows",
          "lines.square_grid.edge_rows",
          "lines.square_grid.interior_left",
          "lines.square_grid.interior_spread",
          "lines.square_grid.interior_rows",
          "lines.square_grid.interior_counts",
          "lines.square_grid.aligned"
        ],
        "changes": ["runtime.presentation_revision", "lines.content_signature"]
      }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-button:has-text('[2000] 博麗神社')" },
      "fields": ["count", "visible", "enabled"],
      "expect": { "count": 1, "visible": true, "enabled": true }
    },
    {
      "type": "click",
      "locator": { "css": ".game-button:has-text('[2000] 博麗神社')" },
      "advances_game": true,
      "semantic_input": 2000
    }
  ],
  "limits": {
    "max_steps": 30,
    "timeout_seconds": 900
  }
}

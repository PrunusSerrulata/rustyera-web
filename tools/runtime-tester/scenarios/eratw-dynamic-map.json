{
  "schema_version": 1,
  "project": "../../../../games/eraTW",
  "mode": "fixed",
  "compiled_cache": false,
  "start": {
    "type": "traditional_save",
    "path": "../../../../games/eraTW/sav/save18.sav"
  },
  "actions": [
    { "type": "input", "value": 120 },
    {
      "type": "assert_dom",
      "locator": { "text": "■博麗神社", "exact": true, "nth": -1 },
      "fields": ["count", "visible"],
      "expect": { "visible": true }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-line" },
      "fields": ["count", "square_grid"],
      "expect": { "square_grid": { "aligned": true, "left": 0, "right": 608 } }
    },
    { "type": "input", "value": 1998 },
    { "type": "input", "value": 400 },
    {
      "type": "click_until_text",
      "locator": { "role": "button", "name": "地図的显示模式", "exact": false },
      "until_text": ["颜色地图"],
      "until_not_text": ["+ 動画"],
      "maximum": 3
    },
    { "type": "input", "value": 999 },
    { "type": "input", "value": 120 },
    {
      "type": "assert_dom",
      "locator": { "text": "■博麗神社", "exact": true, "nth": -1 },
      "fields": ["count", "visible"],
      "expect": { "visible": true }
    },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-line" },
      "fields": ["count", "square_grid"],
      "expect": { "square_grid": { "aligned": true, "left": 0, "right": 608 } }
    },
    { "type": "input", "value": 1998 },
    { "type": "input", "value": 400 },
    {
      "type": "click_until_text",
      "locator": { "role": "button", "name": "地図的显示模式", "exact": false },
      "until_text": ["颜色地图 + 動画"],
      "maximum": 3
    },
    { "type": "input", "value": 999 },
    { "type": "input", "value": 120 },
    {
      "type": "assert_dom",
      "locator": { "css": ".game-line" },
      "fields": ["count", "square_grid"],
      "expect": { "square_grid": { "aligned": true, "left": 0, "right": 608 } }
    },
    {
      "type": "sample_queries",
      "count": 2,
      "interval_ms": 1100,
      "queries": [
        {
          "name": "lines",
          "locator": { "css": ".game-line" },
          "fields": ["content_signature", "square_grid"]
        }
      ],
      "expect": {
        "stable": ["lines.square_grid"],
        "changes": ["runtime.presentation_revision", "lines.content_signature"]
      }
    }
  ],
  "limits": {
    "max_steps": 30,
    "timeout_seconds": 900
  }
}

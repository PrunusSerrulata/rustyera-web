+#[cfg(test)]
+mod native_input_tests {
+    use super::{cursor_in_display_space, native_key, pointer_in_view, require_native_focus};
+    use objc2_foundation::{NSPoint, NSRect, NSSize};
+
+    #[test]
+    fn cursor_mapping_uses_logical_points_and_primary_screen_origin() {
+        let screens = [
+            NSRect::new(NSPoint::new(0.0, 0.0), NSSize::new(1440.0, 900.0)),
+            NSRect::new(NSPoint::new(-1280.0, 100.0), NSSize::new(1280.0, 720.0)),
+            NSRect::new(NSPoint::new(0.0, 900.0), NSSize::new(1920.0, 1080.0)),
+            NSRect::new(NSPoint::new(100.0, -600.0), NSSize::new(800.0, 600.0)),
+        ];
+        for (point, expected) in [
+            (NSPoint::new(92.5, 454.5), NSPoint::new(92.5, 445.5)),
+            (NSPoint::new(-1200.0, 800.0), NSPoint::new(-1200.0, 100.0)),
+            (NSPoint::new(1600.0, 1800.0), NSPoint::new(1600.0, -900.0)),
+            (NSPoint::new(200.0, -500.0), NSPoint::new(200.0, 1400.0)),
+        ] {
+            assert_eq!(cursor_in_display_space(&screens, point).unwrap(), expected);
+        }
+    }
+
+    #[test]

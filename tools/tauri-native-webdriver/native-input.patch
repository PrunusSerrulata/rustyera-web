+    async fn dispatch_pointer_event(
+        &self,
+        kind: PointerEventType,
+        x: i32,
+        y: i32,
+        button: u32,
+    ) -> Result<(), WebDriverErrorResponse> {
+        if button != 0 {
+            return Err(WebDriverErrorResponse::unsupported_operation(
+                "native test input currently supports only the primary pointer button",
+            ));
+        }
+        // The shared Actions handler adds a synthetic Click after a same-position down/up.
+        // AppKit/WebKit already produce that click from the native sequence; never duplicate it.
+        if matches!(kind, PointerEventType::Click) {
+            return Ok(());
+        }
+        let result = self
+            .evaluate_js("({ width: window.innerWidth, height: window.innerHeight })")
+            .await?;
+        let value = result.get("value").ok_or_else(|| {
+            WebDriverErrorResponse::unknown_error("missing native viewport observation")
+        })?;
+        let width = value.get("width").and_then(Value::as_f64).ok_or_else(|| {
+            WebDriverErrorResponse::unknown_error("invalid native viewport width")
+        })?;
+        let height = value.get("height").and_then(Value::as_f64).ok_or_else(|| {
+            WebDriverErrorResponse::unknown_error("invalid native viewport height")
+        })?;
+        self.native_input(NativeInput::Pointer {
+            kind,
+            x,
+            y,
+            width,
+            height,
+        })
+        .await
+    }
+
+    async fn dispatch_key_event(
+        &self,
+        value: &str,
+        down: bool,
+        modifiers: &ModifierState,
+    ) -> Result<(), WebDriverErrorResponse> {
+        let key = native_key(value)?;
+        let mut effective = *modifiers;
+        effective.update(value, down);
+        self.native_input(NativeInput::Key {
+            down,
+            key,
+            modifiers: effective,
+        })
+        .await
+    }
+
+    async fn dispatch_scroll_event(
+        &self,
+        _x: i32,
+        _y: i32,
+        _delta_x: i32,
+        _delta_y: i32,
+    ) -> Result<(), WebDriverErrorResponse> {
+        Err(WebDriverErrorResponse::unsupported_operation(
+            "native test wheel actions are not implemented; use supported native PageUp/PageDown keys",
+        ))
+    }
+
+    async fn click_element(&self, js_var: &str) -> Result<(), WebDriverErrorResponse> {
+        let (x, y) = self.get_element_center(js_var).await?;
+        // Use the same native dispatch path as Actions. Tauri's set_focus also activates
+        // NSApplication asynchronously; reactivating here can consume this click as activation.
+        self.dispatch_pointer_event(PointerEventType::Move, x, y, 0)
+            .await?;
+        self.dispatch_pointer_event(PointerEventType::Down, x, y, 0)
+            .await?;
+        self.dispatch_pointer_event(PointerEventType::Up, x, y, 0)
+            .await
+    }
+
+    async fn clear_element(&self, js_var: &str) -> Result<(), WebDriverErrorResponse> {
+        self.click_element(js_var).await?;
+        let select_all = ModifierState {
+            meta: true,
+            ..ModifierState::default()
+        };
+        self.dispatch_key_event("a", true, &select_all).await?;
+        self.dispatch_key_event("a", false, &select_all).await?;
+        self.dispatch_key_event("\u{E003}", true, &ModifierState::default())
+            .await?;
+        self.dispatch_key_event("\u{E003}", false, &ModifierState::default())
+            .await
+    }
+
+    async fn send_keys_to_element(
+        &self,
+        js_var: &str,
+        text: &str,
+    ) -> Result<(), WebDriverErrorResponse> {
+        if text.len() > 16_384 {
+            return Err(WebDriverErrorResponse::invalid_argument(
+                "native text input exceeds 16384 UTF-8 bytes",
+            ));
+        }
+        // Validate the complete request before a click or partial text insertion can occur.
+        let values: Vec<String> = text
+            .chars()
+            .map(|character| character.to_string())
+            .collect();
+        for value in &values {
+            native_key(value)?;
+        }
+        self.click_element(js_var).await?;
+        for value in values {
+            self.dispatch_key_event(&value, true, &ModifierState::default())
+                .await?;
+            self.dispatch_key_event(&value, false, &ModifierState::default())
+                .await?;
+        }
+        Ok(())
+    }
+

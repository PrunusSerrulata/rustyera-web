{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyEra",
  "version": "0.7.0-tauri",
  "identifier": "org.rustyera.web",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustyEra",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#101114",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob: data:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

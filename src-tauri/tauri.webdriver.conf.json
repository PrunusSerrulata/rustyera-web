{
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustyEra",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "webdriver-test",
          "description": "Capabilities enabled only for the WebdriverIO Tauri test build",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-maximize",
            "core:window:allow-set-position",
            "core:window:allow-set-resizable",
            "core:window:allow-set-size",
            "core:window:allow-unmaximize",
            "dialog:allow-open",
            "dialog:allow-save",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}

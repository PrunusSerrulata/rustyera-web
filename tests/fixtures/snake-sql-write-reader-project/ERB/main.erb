@SYSTEM_TITLE
#LOCALSIZE 1
SQL_CONNECT "main"
SQL_EXECUTE_NONQUERY "main", "CREATE TABLE writer_rows (value INTEGER)"
LOCAL = SQL_EXECUTE_READER("main", "INSERT INTO writer_rows VALUES (7) RETURNING value")
RESULT:0 = SQL_READER_READ(LOCAL)
RESULT:1 = SQL_READER_GET_LONG(LOCAL, 0)
RESULT:2 = SQL_READER_READ(LOCAL)
RESULT:3 = SQL_READER_READ(LOCAL)
RESULT:4 = SQL_READER_CLOSE(LOCAL)
RESULT:5 = SQL_READER_CLOSE(LOCAL)
RESULT:6 = SQL_EXECUTE_SCALAR_LONG("main", "SELECT COUNT(*) FROM writer_rows")
PRINTFORML SNAKE_SQL_WRITE_READER={RESULT:0}/{RESULT:1}/{RESULT:2}/{RESULT:3}/{RESULT:4}/{RESULT:5}/{RESULT:6}
SQL_DISCONNECT "main"
INPUT
RETURN
